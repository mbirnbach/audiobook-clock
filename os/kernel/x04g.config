# Xiaomi Mi Smart Clock X04G – fragment applied on top of arm64 defconfig
CONFIG_LOCALVERSION="-x04g"
CONFIG_ARCH_MEDIATEK=y
CONFIG_ARM64_VA_BITS_39=y
CONFIG_NR_CPUS=4
CONFIG_SCHED_MC=y

# boot / console
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_MT6577=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y

# SoC core
CONFIG_PINCTRL_MT8167=y
CONFIG_PINCTRL_MT6397=y
CONFIG_COMMON_CLK_MT8167=y
CONFIG_COMMON_CLK_MT8167_AUDSYS=y
CONFIG_COMMON_CLK_MT8167_IMGSYS=y
CONFIG_COMMON_CLK_MT8167_MFGCFG=y
CONFIG_COMMON_CLK_MT8167_MMSYS=y
CONFIG_COMMON_CLK_MT8167_VDECSYS=y
CONFIG_COMMON_CLK_MT8516=y
CONFIG_MTK_TIMER=y
CONFIG_MEDIATEK_WATCHDOG=y
CONFIG_MTK_PMIC_WRAP=y
CONFIG_MTK_SCPSYS=y
CONFIG_MTK_SCPSYS_PM_DOMAINS=y
CONFIG_MTK_MMSYS=y
CONFIG_MTK_CMDQ=y
CONFIG_MTK_CMDQ_MBOX=y
CONFIG_MTK_SMI=y
CONFIG_MTK_IOMMU=y
CONFIG_NVMEM_MTK_EFUSE=y
CONFIG_HW_RANDOM_MTK=y
CONFIG_MEDIATEK_MT6577_AUXADC=y
CONFIG_MTK_THERMAL=y
CONFIG_MTK_SOC_THERMAL=y
CONFIG_I2C_MT65XX=y
CONFIG_SPI_MT65XX=y
CONFIG_PWM=y
CONFIG_PWM_MEDIATEK=y
CONFIG_PWM_MTK_DISP=y
CONFIG_ARM_MEDIATEK_CPUFREQ=y
CONFIG_TEE=y
CONFIG_OPTEE=y

# PMIC MT6392
CONFIG_MFD_MT6397=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_MT6392=y
CONFIG_RTC_DRV_MT6397=y
CONFIG_KEYBOARD_MTK_PMIC=y

# storage
CONFIG_MMC=y
CONFIG_MMC_MTK=y
CONFIG_EXT4_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_F2FS_FS=y

# USB gadget (device mode) for ssh over USB
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_DUAL_ROLE=y
CONFIG_USB_MUSB_MEDIATEK=y
CONFIG_PHY_MTK_TPHY=y
CONFIG_EXTCON_USB_GPIO=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_SERIAL=y

# display
CONFIG_DRM=y
CONFIG_DRM_MEDIATEK=y
CONFIG_DRM_MEDIATEK_HDMI=n
CONFIG_DRM_PANEL_FITIPOWER_JD9161Z=y
CONFIG_PHY_MTK_MIPI_DSI=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y

# input
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_MT6779=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_EDT_FT5X06=y

# sensors
CONFIG_IIO=y
CONFIG_EM3071X=m

# audio
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_MEDIATEK=y
CONFIG_SND_SOC_MT8167=y
CONFIG_SND_SOC_MT8516=y
CONFIG_SND_SOC_MT8167_CODEC=y
CONFIG_SND_SOC_MT6392_CODEC=y
CONFIG_SND_SOC_ES7243=y
CONFIG_SND_SOC_MT8167S_ES7243=y
CONFIG_SND_SOC_MTK_BTCVSD=m

# Wi-Fi / BT (vendor CONNSYS port)
CONFIG_CFG80211=y
CONFIG_CFG80211_WEXT=y
CONFIG_NL80211_TESTMODE=y
CONFIG_MAC80211=m
CONFIG_RFKILL=y
CONFIG_BT=m
CONFIG_FW_LOADER=y
CONFIG_MEDIATEK_SOLUTION=y
CONFIG_MTK_PLATFORM="mt8167"
CONFIG_MTK_BTIF=m
CONFIG_MTK_COMBO=m
CONFIG_MTK_COMBO_CHIP_CONSYS_8167=y
CONFIG_MTK_COMBO_COMM=m
CONFIG_MTK_COMBO_WIFI=m
CONFIG_MTK_COMBO_BT=m
CONFIG_MTK_CONN_LTE_IDC_SUPPORT=n
CONFIG_GPS=n
CONFIG_MTK_GPS=n
CONFIG_MTK_WAPI_SUPPORT=n

# required by the vendor CONNSYS driver (uses wakeup sources instead of Android wakelocks)
CONFIG_PM_WAKELOCKS=y

# no PCI bus / desktop GPUs / media on this SoC – keeps build time and size down
CONFIG_PCI=n
CONFIG_DRM_NOUVEAU=n
CONFIG_DRM_AMDGPU=n
CONFIG_DRM_RADEON=n
CONFIG_MEDIA_SUPPORT=n
CONFIG_INFINIBAND=n
CONFIG_STAGING=n
