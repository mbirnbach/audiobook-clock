From c9845f4085086e083fe1ed5d976a89c2401329de Mon Sep 17 00:00:00 2001
From: abs-clock <abs-clock@localhost>
Date: Mon, 26 Oct 2026 18:48:20 +0000
Subject: [PATCH] mediatek: connectivity: build fixes for Linux 7.1

- wmt_gpio.h: linux/of_gpio.h was removed; stub of_get_named_gpio(), only
  used for external combo chips which the MT8167 CONNSYS does not have
- wlan gen2: cfg80211 key/station ops take struct wireless_dev now;
  cfg80211_new_sta()/cfg80211_del_sta() take the wireless_dev
- wlan gen2: gl_proc.c: clamp user copies to buffer size - 1 (off-by-one
  wrote the terminator past the end, count + 1 could overflow)
---
 .../common/common_detect/wmt_gpio.h           | 13 +++++++-
 .../wlan/gen2/os/linux/gl_cfg80211.c          | 32 ++++++++++++++-----
 .../wlan/gen2/os/linux/gl_p2p_cfg80211.c      | 20 +++++++++---
 .../wlan/gen2/os/linux/gl_p2p_kal.c           |  4 +--
 .../connectivity/wlan/gen2/os/linux/gl_proc.c | 15 +++------
 .../wlan/gen2/os/linux/include/gl_cfg80211.h  | 16 +++++-----
 .../wlan/gen2/os/linux/include/gl_p2p_ioctl.h | 10 +++---
 7 files changed, 71 insertions(+), 39 deletions(-)

diff --git a/drivers/misc/mediatek/connectivity/common/common_detect/wmt_gpio.h b/drivers/misc/mediatek/connectivity/common/common_detect/wmt_gpio.h
index 39ed6f65f..425b4a98d 100644
--- a/drivers/misc/mediatek/connectivity/common/common_detect/wmt_gpio.h
+++ b/drivers/misc/mediatek/connectivity/common/common_detect/wmt_gpio.h
@@ -16,7 +16,18 @@
 #define _WMT_GPIO_H_
 
 #include <linux/of.h>
-#include <linux/of_gpio.h>
+#include <linux/of.h>
+
+/*
+ * linux/of_gpio.h is gone from mainline. Only external combo chips
+ * ("mediatek,connectivity-combo" node) use these GPIOs; the MT8167 CONNSYS
+ * has none, so report "no GPIO" exactly like a missing DT property would.
+ */
+static inline int of_get_named_gpio(const struct device_node *np,
+				    const char *propname, int index)
+{
+	return -ENOENT;
+}
 #include <linux/pinctrl/consumer.h>
 #include <linux/pinctrl/pinctrl.h>
 #include <linux/gpio.h>
