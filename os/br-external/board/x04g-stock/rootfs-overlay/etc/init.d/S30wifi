#!/bin/sh
# Wi-Fi: CONNSYS bring-up, wpa_supplicant (config in /data, editable by the app
# through wpa_cli), DHCP on (re)association.

CONF=/data/wifi/wpa_supplicant.conf

bringup() {
	x04g-wifi-up > /data/log/wifi-up.log 2>&1 || echo "S30wifi: bring-up failed"
	if [ ! -s $CONF ]; then
		cat > $CONF <<EOT
ctrl_interface=/var/run/wpa_supplicant
update_config=1
country=DE
EOT
	fi
	wpa_supplicant -B -i wlan0 -c $CONF -P /var/run/wpa_supplicant.pid
	wpa_cli -i wlan0 -a /usr/sbin/x04g-wpa-action -B
	# -b forks after the first -t discover attempts and keeps retrying in the
	# background (-t 0 would retry in the foreground forever)
	udhcpc -i wlan0 -b -t 3 -T 3 -A 5 -x hostname:abs-clock -p /var/run/udhcpc.wlan0.pid
}

# In the background: rcS has to finish for the console and the app to start,
# whatever the radio does.
start() {
	bringup > /dev/null 2>&1 < /dev/null &
}

stop() {
	killall udhcpc wpa_cli wpa_supplicant 2>/dev/null
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart) stop; sleep 1; start ;;
esac
